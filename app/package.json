{
  "name": "proofed",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Proofed — AI agents can buy in seconds, but what if delivery fails? Authorize now, capture only after verified handover.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run tests/state-machine.test.ts tests/policy.test.ts tests/budget.test.ts tests/text.test.ts",
    "test:paypal": "vitest run tests/paypal.integration.test.ts",
    "test:agent": "vitest run tests/agent.e2e.test.ts",
    "test:all": "vitest run",
    "test:e2e": "playwright test tests/e2e/a11y.spec.ts",
    "test:e2e:buyer": "playwright test tests/e2e/buyer-flows.spec.ts",
    "pack": "bash scripts/pack.sh",
    "rename": "bash scripts/rename.sh",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
