# Copy values into your shell or a local .env — never commit real secrets.
# PayPal REST sandbox app (Dashboard → Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional override; default is the PayPal sandbox API
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Required to verify webhook signatures. Create the webhook after you have a public HTTPS URL.
# PAYPAL_WEBHOOK_ID=

# MiniMax OpenAI-compatible API (https://api.minimax.io/v1)
MINIMAX_API_KEY=
# Optional overrides (defaults come from project.config.json)
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# Optional SQLite path (default: ./data/app.sqlite)
# SQLITE_PATH=
